<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Authors>Quantoz Technology</Authors>
    <Version>0.5.0</Version>
    <PackageProjectUrl>https://github.com/QuantozTechnology/Nexutron</PackageProjectUrl>
    <PackageTags>tron, tron protocol, tron grpc</PackageTags>
    <Company>Quantoz Technology</Company>
    <Copyright>Copyright (c) 2026 Quantoz Technology. Based on TronDotNet, copyright (c) 2021 Milad Raeisi (miladsoft).</Copyright>
    <Description>Nexutron is a .NET SDK for working with the TRON blockchain: keys and addresses, TRX and TRC20 transfers, and typed gRPC clients for the java-tron API.
Based on TronDotNet by Milad Raeisi (https://github.com/miladsoft/TronDotNet).</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/QuantozTechnology/Nexutron</RepositoryUrl>
    <PackageReleaseNotes>Release notes are at https://github.com/QuantozTechnology/Nexutron/releases</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nexutron.Protocol\Nexutron.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Nethereum.ABI" Version="7.1.0" />
    <PackageReference Include="Nethereum.Signer" Version="7.1.0" />
    <PackageReference Include="Nethereum.Contracts" Version="7.1.0" />
    <PackageReference Include="Nethereum.Hex" Version="7.1.0" />
    <PackageReference Include="Nethereum.Util" Version="7.1.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nexutron.Tests" />
  </ItemGroup>

</Project>
